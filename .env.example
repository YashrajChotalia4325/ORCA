# ---------------------------------------------------------------- ORCA runtime
ORCA_MODE=LIVE                         # default mode: LIVE | REPLAY | DEMO (clients can override per request)
ORCA_REPLAY_SNAPSHOT=latest            # data/replay/<id> used in REPLAY mode
# ORCA_DATA_DIR=./data
# ORCA_DB_PATH=./data/orca.db
ORCA_MONITOR_ENABLED=true              # proactive alert monitor
ORCA_MONITOR_INTERVAL_S=1800           # keep >= 900 to respect upstream rate limits
ORCA_HTTP_TIMEOUT_S=15

# ---------------------------------------------------------------- security
ORCA_AUTH_REQUIRED=false               # true in any shared deployment
ORCA_API_TOKENS=                       # "token1:authority,token2:admin"  (admin needed for eval runs / probes when auth is on)
ORCA_RATE_LIMIT_PER_MIN=60
ORCA_STORE_PRECISE_LOCATION=false      # stored query locations rounded to 0.1 deg unless true
ORCA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- optional LLM (interpretation fallback + grounded narration)
# ANTHROPIC_API_KEY=
ORCA_LLM_MODEL=claude-opus-5
ORCA_LLM_ENABLED=true

# ---------------------------------------------------------------- restricted sources (adapters activate when configured)
# MOSDAC_USERNAME=
# MOSDAC_PASSWORD=
# COPERNICUSMARINE_SERVICE_USERNAME=
# COPERNICUSMARINE_SERVICE_PASSWORD=
# IMD_API_KEY=                         # IMD also requires IP whitelisting of the deployment
# PROTECTED_PLANET_TOKEN=
# EARTHDATA_TOKEN=
# BHUVAN_TOKEN=
# INCOIS_PFZ_GEOJSON_URL=              # an authorised INCOIS PFZ GeoJSON feed
# INCOIS_OSF_JSON_URL=                 # an authorised INCOIS ocean-state alert feed

# ---------------------------------------------------------------- frontend
NEXT_PUBLIC_ORCA_API=http://localhost:8000
